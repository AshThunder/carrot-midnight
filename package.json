{
  "name": "carrot-midnight",
  "version": "0.1.0",
  "private": true,
  "description": "Carrot Midnight — private two-player bluffing game on Midnight Network",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "bash scripts/compile-compact.sh",
    "compile:skip-zk": "bash scripts/compile-compact.sh --skip-zk",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:domain": "vitest run src/domain",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "lint": "tsc --noEmit",
    "check": "npm test && npm run lint && npm run build && npm run compile",
    "preview:wallet": "node scripts/preview-wallet.mjs",
    "preview:faucet": "node scripts/preview-faucet.mjs",
    "preview:deploy": "NODE_OPTIONS='--max-old-space-size=8192' node scripts/preview-deploy.mjs",
    "preview:live": "node scripts/preview-wallet.mjs && node scripts/preview-faucet.mjs --wait=30 && node scripts/preview-deploy.mjs",
    "deploy:local": "tsx scripts/deploy-local.mjs",
    "test:local": "tsx scripts/test-local.mjs",
    "preprod:wallet": "MIDNIGHT_NETWORK=preprod node scripts/preview-wallet.mjs --network=preprod",
    "preprod:faucet": "MIDNIGHT_NETWORK=preprod node scripts/preview-faucet.mjs --network=preprod",
    "preprod:deploy": "node scripts/patch-dust-sync-speed.mjs; MIDNIGHT_NETWORK=preprod NODE_OPTIONS='--max-old-space-size=12288' WALLET_SYNC_TIMEOUT_MS=2700000 DUST_SYNC_TIMEOUT_MS=2700000 DUST_POLL_MS=20000 DUST_DEBUG=1 tsx scripts/preview-deploy.mjs --network=preprod",
    "preprod:live": "npm run preprod:wallet && npm run preprod:faucet -- --wait=30 && npm run preprod:deploy",
    "postinstall": "node scripts/patch-compact-async-init.mjs; node scripts/patch-indexer-preprod.mjs; node scripts/patch-dust-sync-speed.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.2"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "pino": "^9.6.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.0.5",
    "ws": "^8.18.0"
  },
  "packageManager": "npm@10.9.0",
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.2"
  }
}
