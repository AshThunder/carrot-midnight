# local | preview | preprod
# Default everywhere (code + production build): preprod.
# Vercel does not load .env.example — .env.production sets VITE_MIDNIGHT_NETWORK=preprod at build time.
# Use local only for offline / Docker compose demos.
VITE_MIDNIGHT_NETWORK=preprod

# Optional: override known Preprod contract (defaults match submission/artifacts/deploy-preprod.json)
# VITE_CONTRACT_ADDRESS_PREPROD=0fb9c735e81dcc226d34c543d1cbeac27cd3ec0722e59bb2b31cb4badc2a2c15
# VITE_CONTRACT_TX_PREPROD=0098c5f505555a4b99bb074c1806b6e7b9c240471a1327063e13f1bd722aec2f0a

# Optional headless Preview/Preprod path (scripts/preview-*.mjs)
# MIDNIGHT_NETWORK=preprod
# WALLET_SEED=
# PROOF_SERVER=local
# CAPTCHA_TOKEN=
# TURNSTILE_HEADER=
